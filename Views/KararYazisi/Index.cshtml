@model IEnumerable<KararYazisi>
@{
    ViewData["Title"] = "Karar Yazıları";
    var admin = User.IsInRole("Admin");
}

<h1>Karar Yazıları</h1>

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success">@mesaj</div>
}
@if (TempData["Hata"] is string hata)
{
    <div class="alert alert-danger">@hata</div>
}

@if (admin)
{
    <p><a asp-action="Create" class="btn btn-primary">Yeni Karar</a></p>
}

<table class="table table-striped">
    <thead>
        <tr><th>Karar No</th><th>Tarih</th><th>Gündem</th><th>Durum</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var k in Model)
    {
        <tr>
            <td>@k.KararNo</td>
            <td>@k.Tarih.ToString("dd.MM.yyyy")</td>
            <td>@k.Gundem</td>
            <td>@k.Durum</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@k.Id" class="btn btn-sm btn-outline-secondary">Görüntüle</a>
                @if (admin && k.Durum == KararDurumu.Taslak)
                {
                    <a asp-action="Edit" asp-route-id="@k.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>