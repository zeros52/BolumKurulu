@model KararYazisi
@{ ViewData["Title"] = "Karar " + Model.KararNo; }

<h1>Karar @Model.KararNo</h1>

<dl class="row">
    <dt class="col-sm-2">Tarih</dt><dd class="col-sm-10">@Model.Tarih.ToString("dd.MM.yyyy")</dd>
    <dt class="col-sm-2">Durum</dt><dd class="col-sm-10">@Model.Durum</dd>
    <dt class="col-sm-2">İlgi</dt><dd class="col-sm-10">@(string.IsNullOrWhiteSpace(Model.Ilgi) ? "-" : Model.Ilgi)</dd>
    <dt class="col-sm-2">Gündem</dt><dd class="col-sm-10">@Model.Gundem</dd>
    <dt class="col-sm-2">Karar</dt><dd class="col-sm-10" style="white-space: pre-line">@Model.KararMetni</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Geri</a>