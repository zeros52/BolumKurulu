@model IEnumerable<BolumKurulu.Web.Models.Kurul>

@{
    ViewData["Title"] = "Kurul Yönetimi";
}

<div class="container mt-4">

    <!-- Başlık ve Yeni Kurul Butonu -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Kurul Yönetimi</h2>

        <a asp-controller="Kurul"
           asp-action="Create"
           class="btn btn-primary">
            + Yeni Kurul Ekle
        </a>
    </div>

    <!-- Başarı Mesajları -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }

    <!-- Kurul Listesi -->
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Kurul Adı</th>
                    <th>Açıklama</th>
                    <th>Durum</th>
                    <th>Oluşturulma Tarihi</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var kurul in Model)
                {
                    <tr>
                        <td>@kurul.KurulAdi</td>

                        <td>@(kurul.Aciklama ?? "-")</td>

                        <td>
                            @if (kurul.Aktif)
                            {
                                <span class="badge bg-success">
                                    Aktif
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Pasif
                                </span>
                            }
                        </td>

                        <td>
                            @kurul.OlusturulmaTarihi.ToString("dd.MM.yyyy")
                        </td>

                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">

                                <!-- Kurul Düzenleme -->
                                <a asp-controller="Kurul"
                                   asp-action="Edit"
                                   asp-route-id="@kurul.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Düzenle
                                </a>

                                <!-- Kurul Üyelerini Görüntüleme -->

                                <a asp-controller="KurulUyesi"
                                   asp-action="Index"
                                   asp-route-kurulId="@kurul.Id"
                                   class="btn btn-sm btn-outline-success">
                                    Üyeleri Yönet
                                </a>


                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    <!-- Kayıt Bulunamadı Mesajı -->
    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            Henüz kayıtlı kurul bulunmamaktadır.
        </div>
    }

</div>
