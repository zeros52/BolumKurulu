@model BolumKurulu.Web.Models.KurulUyesiDuzenleViewModel

@{
    ViewData["Title"] = "Kurul Üyeliği Düzenle";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Kurul Üyeliği Düzenle</h2>

        <h5 class="text-muted">
            @Model.KurulAdi
        </h5>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="KurulUyesi"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- Öğretim elemanı bilgileri -->
                <div class="mb-3">
                    <label class="form-label">
                        Öğretim Elemanı
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.OgretimElemaniAdi"
                           readonly />

                    <div class="form-text">
                        Üyelik düzenlenirken öğretim elemanı değiştirilemez.
                    </div>
                </div>

                <!-- Kurul bilgisi -->
                <div class="mb-3">
                    <label class="form-label">
                        Kurul
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.KurulAdi"
                           readonly />
                </div>

                <!-- Görev seçimi -->
                <div class="mb-3">
                    <label asp-for="Gorev"
                           class="form-label">
                        Kuruldaki Görevi
                    </label>

                    <select asp-for="Gorev"
                            class="form-select">
                        <option value="Üye">Üye</option>
                        <option value="Başkan">Başkan</option>
                    </select>

                    <span asp-validation-for="Gorev"
                          class="text-danger"></span>
                </div>

                <!-- Başlangıç tarihi -->
                <div class="mb-3">
                    <label asp-for="BaslangicTarihi"
                           class="form-label">
                        Başlangıç Tarihi
                    </label>

                    <input asp-for="BaslangicTarihi"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="BaslangicTarihi"
                          class="text-danger"></span>
                </div>

                <!-- Bitiş tarihi -->
                <div class="mb-3">
                    <label asp-for="BitisTarihi"
                           class="form-label">
                        Bitiş Tarihi (İsteğe Bağlı)
                    </label>

                    <input asp-for="BitisTarihi"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="BitisTarihi"
                          class="text-danger"></span>
                </div>

                <!-- Aktif / Pasif -->
                <div class="form-check mb-4">
                    <input asp-for="Aktif"
                           class="form-check-input"
                           type="checkbox" />

                    <label asp-for="Aktif"
                           class="form-check-label">
                        Üyelik Aktif
                    </label>

                    <span asp-validation-for="Aktif"
                          class="text-danger d-block"></span>
                </div>

                <!-- İşlem butonları -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Değişiklikleri Kaydet
                    </button>

                    <a asp-controller="KurulUyesi"
                       asp-action="Index"
                       asp-route-kurulId="@Model.KurulId"
                       class="btn btn-secondary">
                        İptal
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
