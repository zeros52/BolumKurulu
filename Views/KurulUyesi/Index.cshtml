@model IEnumerable<BolumKurulu.Web.Models.KurulUyesi>

@{
    ViewData["Title"] = "Kurul Üyeleri";

    int kurulId = (int)ViewBag.KurulId;
    string kurulAdi = (string)ViewBag.KurulAdi;
    bool kurulAktif = (bool)ViewBag.KurulAktif;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center
        flex-wrap gap-3 mb-4">

        <div>
            <h2 class="mb-1">Kurul Üyeleri</h2>
            <h5 class="text-muted mb-0">@kurulAdi</h5>
        </div>

        <div class="d-flex gap-2">

            @if (kurulAktif)
            {
                <a asp-controller="KurulUyesi"
                   asp-action="Create"
                   asp-route-kurulId="@kurulId"
                   class="btn btn-primary">
                    + Üye Ekle
                </a>
            }

            <a asp-controller="Kurul"
               asp-action="Index"
               class="btn btn-secondary">
                Kurullara Dön
            </a>

        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success
            alert-dismissible fade show"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger
            alert-dismissible fade show"
             role="alert">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }

    @if (!kurulAktif)
    {
        <div class="alert alert-warning" role="alert">
            Bu kurul pasif durumdadır.
            Yeni üye ataması yapılamaz.
        </div>
    }

    <div class="table-responsive">

        <table class="table table-striped
            table-bordered align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Ad Soyad</th>
                    <th>Sicil No</th>
                    <th>Görev</th>
                    <th>Başlangıç Tarihi</th>
                    <th>Bitiş Tarihi</th>
                    <th>Durum</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var uye in Model)
                {
                    <tr>
                        <td>
                            @uye.OgretimElemani.AdSoyad
                        </td>

                        <td>
                            @uye.OgretimElemani.SicilNo
                        </td>

                        <td>
                            @uye.Gorev
                        </td>

                        <td>
                            @uye.BaslangicTarihi.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @(uye.BitisTarihi?.ToString("dd.MM.yyyy") ?? "-")
                        </td>

                        <td>
                            @if (uye.Aktif)
                            {
                                <span class="badge bg-success">
                                    Aktif
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Pasif
                                </span>
                            }
                        </td>

                        <td class="text-center">
                            <div class="d-flex
                                justify-content-center
                                flex-wrap gap-2">

                                <a asp-controller="KurulUyesi"
                                   asp-action="Edit"
                                   asp-route-id="@uye.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Düzenle
                                </a>

                                <!-- Yalnızca aktif üyelik sonlandırılabilir -->
                                @if (uye.Aktif)
                                {
                                    <a asp-controller="KurulUyesi"
                                       asp-action="Sonlandir"
                                       asp-route-id="@uye.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Sonlandır
                                    </a>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            Bu kurula henüz öğretim elemanı atanmamıştır.
        </div>
    }

</div>
